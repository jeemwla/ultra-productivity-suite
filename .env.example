# Ultra Suite settings for running from source (dev.ps1). Copy this file to .env and fill in what you need.
# .env is private to your PC and is never uploaded to GitHub.
# The installed app keeps its own copy at %APPDATA%\UltraSuite\settings.env and creates it on first run.

# Private token shared by the suite's own processes. Any long random string.
BRIDGE_TOKEN=

# --- Code Red Alarm ----------------------------------------------------------
# Optional: preferred speaker the first time the app runs (part of its name, e.g. "Speakers" or "Headphones").
# You can always pick a speaker later in the alarm app under Sound.
ALARM_SPEAKER_MATCH=
DEFAULT_RING_DURATION_SEC=600

# --- PC Sentinel ---------------------------------------------------------------
# LibreHardwareMonitor (optional, for the most detailed sensors) serves them on port 8085.
LHM_REMOTE_URL=http://127.0.0.1:8085/data.json
# Optional: latency targets as Name|host|port, comma separated
# PING_TARGETS=Cloudflare|1.1.1.1|53,Google|8.8.8.8|53,Router|192.168.8.1|80

# --- VPN button (optional) -----------------------------------------------------
# Your router's IP. The VPN button runs your own PowerShell script:
# it is called as  <script> -State on|off  and should exit 0 on success.
GLINET_ROUTER_IP=
GLINET_VPN_TYPE=wireguard
ONESCRIPT_PATH=
GLINET_ADMIN_PASSWORD=
