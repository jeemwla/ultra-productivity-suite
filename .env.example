# Ultra Productivity Suite settings. Setup.cmd copies this to .env and fills it in for you.
# .env is private to your PC and is never uploaded to GitHub.

# "native" (default, no Docker needed) or "docker"
SUITE_MODE=native

# Private token shared by the suite's own processes. Setup creates a random one.
BRIDGE_TOKEN=

# --- Code Red Alarm ----------------------------------------------------------
# Optional: preferred speaker the first time the app runs (part of its name, e.g. "Pebble").
# You can always pick a speaker later in the alarm app under Sound.
PEBBLE_DEVICE_MATCH=
DEFAULT_RING_DURATION_SEC=600
HOST_AUDIO_BRIDGE_PORT=8091

# --- PC Sentinel ---------------------------------------------------------------
# Filled in by Setup. LibreHardwareMonitor serves sensors on port 8085.
LHM_EXE=
LHM_REMOTE_URL=http://127.0.0.1:8085/data.json
# Optional: latency targets as Name|host|port, comma separated
# PING_TARGETS=Cloudflare|1.1.1.1|53,Google|8.8.8.8|53,Router|192.168.8.1|80

# --- VPN button (optional) -----------------------------------------------------
# Your router's IP (Setup detects it). The VPN button runs your own PowerShell script:
# it is called as  <script> -State on|off  and should exit 0 on success.
GLINET_ROUTER_IP=
GLINET_VPN_TYPE=wireguard
ONESCRIPT_PATH=
GLINET_ADMIN_PASSWORD=

# --- Docker mode only ------------------------------------------------------------
# Time zone for the Docker containers. The Windows apps ignore TZ and follow the Windows time zone.
TZ=America/Los_Angeles
TS_AUTHKEY=
