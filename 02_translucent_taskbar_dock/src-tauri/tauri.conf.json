{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ultra Dock",
  "version": "1.1.0",
  "identifier": "com.ultrasuite.dock",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ultra Dock",
        "width": 520,
        "height": 64,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": true,
        "focus": false
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
