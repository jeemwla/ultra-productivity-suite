{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ultra Suite",
  "mainBinaryName": "Ultra Suite",
  "version": "2.2.1",
  "identifier": "com.ultrasuite.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Ultra Suite",
    "shortDescription": "In-taskbar app groups, Code Red Alarm and PC Sentinel",
    "longDescription": "Ultra Suite: a taskbar strip that groups your apps, an alarm you can't ignore, and a live hardware and network monitor.",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../build/dist/ultrasuite-core/": "core/",
      "appicons/": "appicons/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  }
}
